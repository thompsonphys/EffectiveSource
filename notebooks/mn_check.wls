dir = DirectoryName[$InputFileName];
nb = Get[FileNameJoin[{dir, "ScalarSingularField.nb"}]];
Do[Quiet[ToExpression[b, StandardForm]], {b, Cases[nb, Cell[b_BoxData, "Input", ___] :> b, Infinity]}];
If[Length[$ScriptCommandLine] >= 2, Get[$ScriptCommandLine[[2]]]];
results = {};
check[name_, ok_, val_] := (AppendTo[results, TrueQ[ok]]; Print["check ", name, " ", If[TrueQ[ok], "PASS", "FAIL"], " ", val]);
digits[x_, y_] := If[x == y, Infinity, N[-Log10[Abs[x - y]/Max[Abs[x], Abs[y]]], 4]];
orb = KerrEquatorialOrbit[1/2, 10, 3/10, 110];
geo = KerrEquatorialConstants[1, 1/2, 10, 3/10, 9, 110];
lc9 = CrossingTime[orb, N[9, 110]];
check["geodesic-EL", Min[digits[orb["E"], e1 /. geo], digits[orb["L"], l1 /. geo]] >= 60, {digits[orb["E"], e1 /. geo], digits[orb["L"], l1 /. geo]}];
check["geodesic-ur", Min[digits[ur1 /. ParticleAt[orb, lc9]["pars"], ur1 /. geo], digits[ur1 /. ParticleAt[orb, orb["LambdaR"] - lc9]["pars"], -(ur1 /. geo)]] >= 60, {digits[ur1 /. ParticleAt[orb, lc9]["pars"], ur1 /. geo], digits[ur1 /. ParticleAt[orb, orb["LambdaR"] - lc9]["pars"], -(ur1 /. geo)]}];
lam = N[7/10, 110];
check["orbit-derivatives", Min[digits[orb["dt"][lam], Derivative[1][orb["t"]][lam]], digits[orb["ddt"][lam], Derivative[2][orb["t"]][lam]]] >= 90, {digits[orb["dt"][lam], Derivative[1][orb["t"]][lam]], digits[orb["ddt"][lam], Derivative[2][orb["t"]][lam]]}];
check["orbit-period", digits[orb["OmegaR"], 2 Pi/orb["TR"]] >= 90 && Abs[orb["r"][orb["LambdaR"]] - orb["r"][0]] < 10^-95 && Abs[orb["t"][-lam] + orb["t"][lam]] < 10^-90 && Abs[orb["phi"][-lam] + orb["phi"][lam]] < 10^-90, N[{orb["r"][orb["LambdaR"]] - orb["r"][0], orb["t"][-lam] + orb["t"][lam], orb["phi"][-lam] + orb["phi"][lam]}, 3]];
lc11 = CrossingTime[orb, N[11, 110]];
check["crossing", 0 < lc11 < orb["LambdaR"]/2 && Abs[orb["r"][lc11] - 11] < 10^-95, N[orb["r"][lc11] - 11, 3]];
pa = PunctureAt[orb, lam];
tw = TwistedPuncture[ParticleAt[orb, lam]["pars"]];
{d1, d2, d3} = N[{3/10, 1/20, 1/5}, 110];
f = TwistedPhiS[tw, x1, x2, x3];
ref = {f, D[f, x1], D[f, x2], D[f, x3], D[f, x1, x1], D[f, x2, x2], D[f, x3, x3]} /. {x1 -> d1, x2 -> d2, x3 -> d3};
mine = Values[PunctureDerivatives[pa, d1, d2, d3 - pa["c"] d1, 2]];
check["puncture-derivatives", Min[MapThread[digits, {mine, ref}]] >= 90, MapThread[digits, {mine, ref}]];
xs = N[{-1/2, 1/10, 2}, 110];
vec = PunctureDerivatives[pa, d1, d2, xs, 2];
check["puncture-vector", Max[Abs[Flatten[Values[vec]] - Flatten[Transpose[Table[Values[PunctureDerivatives[pa, d1, d2, x, 2]], {x, xs}]]]]] == 0, "-"];
pts = {{11, 1/50, 1/100}, {107/7, 2/25, -1/5}, {9, ArcSin[2/5], 1/2}};
lam3 = N[3/10, 110];
src = EffectiveSource4D[orb, lam3, N[10^-12, 110]];
srcHalf = EffectiveSource4D[orb, lam3, N[5 10^-13, 110]];
pf = PointFields[orb, lam3, N[10^-12, 110]];
pp = ParticleAt[orb, lam3]["phip"];
par = Table[With[{r = N[pt[[1]], 110], dt = N[pt[[2]], 110], ph = pp + N[pt[[3]], 110]}, Min[digits[pf[r, Pi/2 + dt, ph, 2]["Phi"], pf[r, Pi/2 - dt, ph, 2]["Phi"]], digits[pf[r, Pi/2 + dt, ph, 2]["box"], pf[r, Pi/2 - dt, ph, 2]["box"]]]], {pt, pts}];
check["parity", Min[par] >= 80, par];
stp = Table[With[{r = N[pt[[1]], 110], th = Pi/2 + N[pt[[2]], 110], ph = pp + N[pt[[3]], 110]}, digits[src[r, th, ph], srcHalf[r, th, ph]]], {pt, pts}];
check["source-step", Min[stp] >= 30, stp];
orb150 = KerrEquatorialOrbit[1/2, 10, 3/10, 150];
src150 = EffectiveSource4D[orb150, N[3/10, 150], N[10^-20, 150]];
p150 = ParticleAt[orb150, N[3/10, 150]];
lin[d_] := Abs[src150[p150["rp"] + d, Pi/2 + d, p150["phip"] + d]];
ratio = lin[N[10^-6, 150]]/lin[N[10^-3, 150]];
check["source-linear", Abs[ratio - 10^-3] < 10^-4, N[{ratio, lin[N[10^-3, 150]], lin[N[10^-6, 150]]}, 5]];
innerRef[lv_, r_, th_, m_, q_] := Module[{pt = ParticleAt[orb, lv], tw1, g, dr0, dth0, y1, y2, y3, s1, h},
  tw1 = TwistedPuncture[pt["pars"]]; dr0 = r - pt["rp"]; dth0 = th - Pi/2;
  If[q === "box",
    s1 = EffectiveSource4D[orb, lv, N[10^-12, 110]];
    h[y_?NumericQ] := s1[r, th, pt["phip"] + y];
    Exp[-I m pt["phip"]] Quiet[NIntegrate[h[y3] Exp[-I m y3], {y3, tw1["c"] dr0 - Pi, tw1["c"] dr0, tw1["c"] dr0 + Pi}, WorkingPrecision -> 60, PrecisionGoal -> 36, MaxRecursion -> 60]],
    g = With[{ff = TwistedPhiS[tw1, y1, y2, y3]}, Switch[q, "Phi", ff, "r", D[ff, y1], "th", D[ff, y2], "rr", D[ff, y1, y1], "thth", D[ff, y2, y2]]] /. {y1 -> dr0, y2 -> dth0};
    Exp[-I m pt["phip"]] Quiet[NIntegrate[g Exp[-I m y3], {y3, tw1["c"] dr0 - Pi, tw1["c"] dr0, tw1["c"] dr0 + Pi}, WorkingPrecision -> 80, PrecisionGoal -> 36, MaxRecursion -> 60]]]];
innerDigits[lv_, r_, th_, qs_, mm_] := Module[{smp = MModeSamples[orb, lv, r, th, {0, 2, 10}, qs, 32]},
  Flatten[Table[digits[smp[q][[Position[{0, 2, 10}, m][[1, 1]]]], innerRef[lv, r, th, m, q]], {q, qs}, {m, mm}]]];
paC = PunctureAt[orb, lc11];
w11 = Sqrt[paC["alpha02"]/paC["alpha20"]] N[1/200, 110]/Abs[orb["dr"][lc11]];
inOff = Flatten[Table[innerDigits[lc11 + dl, N[11, 110], Pi/2 + N[1/200, 110], {"Phi", "r", "th", "rr", "thth"}, {0, 2, 10}], {dl, {-w11/20, w11/20, w11, -3 w11}}]];
inBox = innerDigits[lc11 + w11/20, N[11, 110], Pi/2 + N[1/200, 110], {"box"}, {2}];
inPlane = Flatten[Table[innerDigits[lc9 + dl, N[9, 110], Pi/2, {"Phi", "r"}, {0, 2, 10}], {dl, N[{10^-6, -10^-3}, 110]}]];
check["inner-rule", Min[Join[inOff, inBox, inPlane]] >= 32, {Min[inOff], Min[inBox], Min[inPlane]}];
nd = Table[MNNodes[orb, N[pt[[1]], 110], If[pt[[2]] === 0, Pi/2, Pi/2 + N[pt[[2]], 110]], rule], {pt, {{107/7, 2/25}, {11, 1/200}, {9, 0}}}, {rule, {"primary", "check"}}];
check["nodes", And @@ Flatten[Table[OrderedQ[nd[[i, j, 1]]] && 0 < Min[nd[[i, j, 1]]] && Max[nd[[i, j, 1]]] < orb["LambdaR"]/2 && Abs[Total[nd[[i, j, 2]]] - orb["LambdaR"]/2] < 10^-33, {i, 3}, {j, 2}]], Map[Length[First[#]] &, nd, {2}]];
far = MNModes[orb, N[107/7, 110], Pi/2 + N[2/25, 110], {0, 2}, {-3, -1, 0, 1, 3}, {"Phi"}];
check["projection-digits", Min[far["digits"]["Phi"]] >= 30, far["digits"]["Phi"]];
sym = Table[digits[far["values"]["Phi"][[1, k]], far["values"]["Phi"][[1, 6 - k]]], {k, 2}];
check["projection-m0-symmetry", Min[sym] >= 30, sym];
real = MNModes[orb, N[107/7, 110], Pi/2 + N[2/25, 110], {2}, {-1, 0, 1}, {"Phi"}, "FullPeriod" -> True, "Rules" -> {"primary"}];
imr = Max[Abs[Im[real["values"]["Phi"][[1]]]]]/Max[Abs[real["values"]["Phi"][[1]]]];
check["projection-reality", imr <= 10^-30, N[imr, 3]];
ad = MNModeAdaptive[orb, N[107/7, 110], Pi/2 + N[2/25, 110], 2, 0, "Phi", 20];
check["projection-adaptive", digits[ad, far["values"]["Phi"][[2, 3]]] >= 18, digits[ad, far["values"]["Phi"][[2, 3]]]];
Exit[If[And @@ results, 0, 1]];
