Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MNModeAdaptive", "[", 
    RowBox[{
    "orb_", ",", " ", "r_", ",", " ", "th_", ",", " ", "m_", ",", " ", "n_", 
     ",", " ", "q_", ",", " ", 
     RowBox[{"pg_", " ", ":", " ", "30"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"om", " ", "=", " ", 
        RowBox[{
         RowBox[{"m", " ", 
          RowBox[{"orb", "[", "\"\<OmegaPhi\>\"", "]"}]}], " ", "+", " ", 
         RowBox[{"n", " ", 
          RowBox[{"orb", "[", "\"\<OmegaR\>\"", "]"}]}]}]}], ",", " ", 
       RowBox[{"half", " ", "=", " ", 
        RowBox[{
         RowBox[{"orb", "[", "\"\<LambdaR\>\"", "]"}], "/", "2"}]}], ",", " ",
        "inRange", ",", " ", "lc", ",", " ", "inner", ",", " ", "l", ",", " ",
        "rng"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"inRange", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"orb", "[", "\"\<p\>\"", "]"}], "/", 
         RowBox[{"(", 
          RowBox[{"1", " ", "+", " ", 
           RowBox[{"orb", "[", "\"\<e\>\"", "]"}]}], ")"}]}], " ", "<", " ", 
        "r", " ", "<", " ", 
        RowBox[{
         RowBox[{"orb", "[", "\"\<p\>\"", "]"}], "/", 
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", 
           RowBox[{"orb", "[", "\"\<e\>\"", "]"}]}], ")"}]}]}]}], ";", "\n", 
      "  ", 
      RowBox[{
       RowBox[{"inner", "[", 
        RowBox[{"lv_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"pt", " ", "=", " ", 
            RowBox[{"ParticleAt", "[", 
             RowBox[{"orb", ",", " ", "lv"}], "]"}]}], ",", " ", "tw", ",", 
           " ", "f", ",", " ", "g", ",", " ", "dr0", ",", " ", "dth0", ",", 
           " ", "x", ",", " ", "d1", ",", " ", "d2"}], "}"}], ",", "\n", 
         "    ", 
         RowBox[{
          RowBox[{"tw", " ", "=", " ", 
           RowBox[{"TwistedPuncture", "[", 
            RowBox[{"pt", "[", "\"\<pars\>\"", "]"}], "]"}]}], ";", " ", 
          RowBox[{"dr0", " ", "=", " ", 
           RowBox[{"r", " ", "-", " ", 
            RowBox[{"pt", "[", "\"\<rp\>\"", "]"}]}]}], ";", " ", 
          RowBox[{"dth0", " ", "=", " ", 
           RowBox[{"th", " ", "-", " ", 
            RowBox[{"Pi", "/", "2"}]}]}], ";", "\n", "    ", 
          RowBox[{"f", " ", "=", " ", 
           RowBox[{"TwistedPhiS", "[", 
            RowBox[{"tw", ",", " ", "d1", ",", " ", "d2", ",", " ", "x"}], 
            "]"}]}], ";", "\n", "    ", 
          RowBox[{"g", " ", "=", " ", 
           RowBox[{
            RowBox[{"Switch", "[", 
             RowBox[{
             "q", ",", " ", "\"\<Phi\>\"", ",", " ", "f", ",", " ", 
              "\"\<r\>\"", ",", " ", 
              RowBox[{"D", "[", 
               RowBox[{"f", ",", " ", "d1"}], "]"}], ",", " ", "\"\<th\>\"", 
              ",", " ", 
              RowBox[{"D", "[", 
               RowBox[{"f", ",", " ", "d2"}], "]"}]}], "]"}], " ", "/.", " ", 
            
            RowBox[{"{", 
             RowBox[{
              RowBox[{"d1", " ", "->", " ", "dr0"}], ",", " ", 
              RowBox[{"d2", " ", "->", " ", "dth0"}]}], "}"}]}]}], ";", "\n", 
          "    ", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "I"}], " ", "m", " ", 
             RowBox[{"pt", "[", "\"\<phip\>\"", "]"}]}], "]"}], " ", 
           RowBox[{"Quiet", "[", 
            RowBox[{"NIntegrate", "[", 
             RowBox[{
              RowBox[{"g", " ", 
               RowBox[{"Exp", "[", 
                RowBox[{
                 RowBox[{"-", "I"}], " ", "m", " ", "x"}], "]"}]}], ",", " ", 
              
              RowBox[{"{", 
               RowBox[{"x", ",", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"tw", "[", "\"\<c\>\"", "]"}], " ", "dr0"}], " ", 
                 "-", " ", "Pi"}], ",", " ", 
                RowBox[{
                 RowBox[{"tw", "[", "\"\<c\>\"", "]"}], " ", "dr0"}], ",", 
                " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"tw", "[", "\"\<c\>\"", "]"}], " ", "dr0"}], " ", 
                 "+", " ", "Pi"}]}], "}"}], ",", " ", 
              RowBox[{"WorkingPrecision", " ", "->", " ", "60"}], ",", " ", 
              RowBox[{"PrecisionGoal", " ", "->", " ", 
               RowBox[{"pg", " ", "+", " ", "5"}]}], ",", " ", 
              RowBox[{"MaxRecursion", " ", "->", " ", "60"}]}], "]"}], 
            "]"}]}]}]}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"rng", " ", "=", " ", 
       RowBox[{"If", "[", 
        RowBox[{"inRange", ",", " ", 
         RowBox[{
          RowBox[{"lc", " ", "=", " ", 
           RowBox[{"CrossingTime", "[", 
            RowBox[{"orb", ",", " ", "r"}], "]"}]}], ";", " ", 
          RowBox[{"{", 
           RowBox[{"l", ",", " ", "0", ",", " ", "lc", ",", " ", "half"}], 
           "}"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"l", ",", " ", "0", ",", " ", "half"}], "}"}]}], "]"}]}], 
      ";", "\n", "  ", 
      RowBox[{
       RowBox[{"2", "/", 
        RowBox[{"orb", "[", "\"\<TR\>\"", "]"}]}], " ", 
       RowBox[{"Re", "[", 
        RowBox[{"Quiet", "[", 
         RowBox[{"NIntegrate", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"orb", "[", "\"\<dt\>\"", "]"}], "[", "l", "]"}], " ", 
            RowBox[{"Exp", "[", 
             RowBox[{"I", " ", "om", " ", 
              RowBox[{
               RowBox[{"orb", "[", "\"\<t\>\"", "]"}], "[", "l", "]"}]}], 
             "]"}], " ", 
            RowBox[{"inner", "[", "l", "]"}]}], ",", " ", 
           RowBox[{"Evaluate", "[", "rng", "]"}], ",", " ", 
           RowBox[{"Method", " ", "->", " ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"inRange", " ", "&&", " ", 
               RowBox[{
                RowBox[{"th", " ", "-", " ", 
                 RowBox[{"Pi", "/", "2"}]}], " ", "==", " ", "0"}], " ", "&&",
                " ", 
               RowBox[{"q", " ", "===", " ", "\"\<r\>\""}]}], ",", " ", 
              "\"\<PrincipalValue\>\"", ",", " ", "Automatic"}], "]"}]}], ",",
            " ", 
           RowBox[{"WorkingPrecision", " ", "->", " ", "50"}], ",", " ", 
           RowBox[{"PrecisionGoal", " ", "->", " ", "pg"}], ",", " ", 
           RowBox[{"MaxRecursion", " ", "->", " ", "40"}]}], "]"}], "]"}], 
        "]"}]}]}]}], "]"}]}], ";"}]], "Input",ExpressionUUID->"83012fae-720a-\
