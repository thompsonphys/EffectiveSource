Cell[BoxData[
 RowBox[{
  RowBox[{"\[Alpha]5", "=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", 
      RowBox[{"6", " ", 
       SubsuperscriptBox[
        OverscriptBox["r", "~"], "0", "6"], " ", 
