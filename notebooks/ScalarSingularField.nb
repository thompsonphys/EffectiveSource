Cell[CellGroupData[{

Cell["Kerr equatorial geodesic: constants of motion", "Section",
 CellChangeTimes->{{4.000628310133822*^9, 
  4.000628311713726*^9}},ExpressionUUID->"52ceffa6-9c5d-4ea1-bde3-\
cbed26cd5cdd"],

Cell["\<\
KerrEquatorialConstants[M, a, p, e, r, prec] returns the rules {r1, e1, l1, \
ur1} for the prograde equatorial geodesic with semi-latus rectum p and \
eccentricity e, evaluated at radius r. E and L solve R(p/(1+e)) = R(p/(1-e)) \
= 0 with R(r) = (e1 (r^2+a^2) - a l1)^2 - (r^2 - 2 M r + a^2)(r^2 + (l1 - a \
e1)^2); ur1 = Sqrt[R(r)]/r^2. prec is the working precision of FindRoot.\
\>", "Text",ExpressionUUID->"3e850dcd-e010-4287-8736-a55429226b34"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"KerrEquatorialConstants", "[", 
    RowBox[{
    "M_", ",", " ", "a_", ",", " ", "p_", ",", " ", "e_", ",", " ", "r_", ",",
      " ", "prec_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "R", ",", " ", "v", ",", " ", "den", ",", " ", "E0", ",", " ", "L0", 
       ",", " ", "sol", ",", " ", "EE", ",", " ", "LL"}], "}"}], ",", "\n", 
     "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"R", "[", 
        RowBox[{"x_", ",", " ", "en_", ",", " ", "l_"}], "]"}], " ", ":=", 
       " ", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"en", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"x", "^", "2"}], " ", "+", " ", 
              RowBox[{"a", "^", "2"}]}], ")"}]}], " ", "-", " ", 
           RowBox[{"a", " ", "l"}]}], ")"}], "^", 
         RowBox[{"2", " ", "'"}]}], "-", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"x", "^", "2"}], " ", "-", " ", 
           RowBox[{"2", " ", "M", " ", "x"}], " ", "+", " ", 
           RowBox[{"a", "^", "2"}]}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"x", "^", "2"}], " ", "+", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"l", " ", "-", " ", 
              RowBox[{"a", " ", "en"}]}], ")"}], "^", "2"}]}], ")"}]}]}]}], 
      ";", "\n", "  ", 
      RowBox[{"v", " ", "=", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"M", "/", "p"}], "]"}]}], ";", " ", 
      RowBox[{"den", " ", "=", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"3", " ", 
          RowBox[{"v", "^", "2"}]}], " ", "+", " ", 
         RowBox[{"2", " ", 
          RowBox[{"a", "/", "M"}], " ", 
          RowBox[{"v", "^", "3"}]}]}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"E0", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"2", " ", 
           RowBox[{"v", "^", "2"}]}], " ", "+", " ", 
          RowBox[{
           RowBox[{"a", "/", "M"}], " ", 
           RowBox[{"v", "^", "3"}]}]}], ")"}], "/", "den"}]}], ";", " ", 
      RowBox[{"L0", " ", "=", " ", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"M", " ", "p"}], "]"}], " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", 
           RowBox[{"2", " ", 
            RowBox[{"a", "/", "M"}], " ", 
            RowBox[{"v", "^", "3"}]}], " ", "+", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"a", "^", "2"}], "/", 
             RowBox[{"M", "^", "2"}]}], " ", 
            RowBox[{"v", "^", "4"}]}]}], ")"}], "/", "den"}]}]}], ";", "\n", 
      "  ", 
      RowBox[{"sol", " ", "=", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"e", " ", "==", " ", "0"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"EE", " ", "->", " ", "E0"}], ",", " ", 
           RowBox[{"LL", " ", "->", " ", "L0"}]}], "}"}], ",", "\n", "    ", 
         RowBox[{"FindRoot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"R", "[", 
               RowBox[{
                RowBox[{"p", "/", 
                 RowBox[{"(", 
                  RowBox[{"1", " ", "+", " ", "e"}], ")"}]}], ",", " ", "EE", 
                ",", " ", "LL"}], "]"}], " ", "==", " ", "0"}], ",", " ", 
             RowBox[{
              RowBox[{"R", "[", 
               RowBox[{
                RowBox[{"p", "/", 
                 RowBox[{"(", 
                  RowBox[{"1", " ", "-", " ", "e"}], ")"}]}], ",", " ", "EE", 
                ",", " ", "LL"}], "]"}], " ", "==", " ", "0"}]}], "}"}], ",", 
           " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"EE", ",", " ", 
               RowBox[{"N", "[", 
                RowBox[{"E0", ",", " ", "prec"}], "]"}]}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"LL", ",", " ", 
               RowBox[{"N", "[", 
                RowBox[{"L0", ",", " ", "prec"}], "]"}]}], "}"}]}], "}"}], 
           ",", " ", 
           RowBox[{"WorkingPrecision", " ", "->", " ", "prec"}]}], "]"}]}], 
        "]"}]}], ";", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"r1", " ", "->", " ", "r"}], ",", " ", 
        RowBox[{"e1", " ", "->", " ", 
         RowBox[{"(", 
          RowBox[{"EE", " ", "/.", " ", "sol"}], ")"}]}], ",", " ", 
        RowBox[{"l1", " ", "->", " ", 
         RowBox[{"(", 
          RowBox[{"LL", " ", "/.", " ", "sol"}], ")"}]}], ",", " ", 
        RowBox[{"ur1", " ", "->", " ", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{"R", "[", 
             RowBox[{"r", ",", " ", "EE", ",", " ", "LL"}], "]"}], " ", "/.", 
            " ", "sol"}], "]"}], "/", 
          RowBox[{"r", "^", "2"}]}]}]}], "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{
  4.00062826438239*^9},ExpressionUUID->"0b8eaf05-a3ee-4eac-be47-c33f034abe01"]
}, Closed]],

Cell[CellGroupData[{

Cell["Kerr equatorial geodesic: twisted azimuthal coordinate", "Section",ExpressionUUID->"60ec90e7-4d98-484c-a43c-dad8bb7a3ead"],

Cell["\<\
The cross term proportional to \[CapitalDelta]r \[CapitalDelta]R in the \
denominator of \[CapitalPhi]sKerrEquatorial prevents a closed-form m-mode \
decomposition. With \[CapitalDelta]\[Phi]b = \[CapitalDelta]\[Phi] - c \
\[CapitalDelta]r and c chosen to cancel that term at leading order, \
TwistedPuncture[pars] substitutes \[CapitalDelta]Q^2 = (1 - (1 - 2 \
\[CapitalDelta]Qb^2) cos(c \[CapitalDelta]r) + \[CapitalDelta]Rb sin(c \
\[CapitalDelta]r))/2 and \[CapitalDelta]R = \[CapitalDelta]Rb cos(c \
\[CapitalDelta]r) + (1 - 2 \[CapitalDelta]Qb^2) sin(c \[CapitalDelta]r), with \
\[CapitalDelta]Qb = sin(\[CapitalDelta]\[Phi]b/2) and \[CapitalDelta]Rb = \
sin(\[CapitalDelta]\[Phi]b). It expands to ninth order in (\[CapitalDelta]r, \
\[CapitalDelta]\[Theta], \[CapitalDelta]Qb, \[CapitalDelta]Rb), reduces \
\[CapitalDelta]Rb^2 = 4 \[CapitalDelta]Qb^2 (1 - \[CapitalDelta]Qb^2), and \
returns c, \[Alpha]20, \[Alpha]02, \[Beta] and the numerator A of \
\[CapitalPhi]s = A/(\[Alpha]20 \[CapitalDelta]r^2 + \[Alpha]02 \
\[CapitalDelta]\[Theta]^2 + \[Beta] \[CapitalDelta]Qb^2)^(7/2). For geodesic \
parameters the coefficients of A are those of kerr-equatorial-coeffs-ctx.c. \
The parameters must be numbers; exact rationals give an exact result. \
TwistedPhiS[tw, \[CapitalDelta]r, \[CapitalDelta]\[Theta], \[CapitalDelta]\
\[Phi]] evaluates the twisted form.\
\>", "Text",ExpressionUUID->"8c435337-6257-4f9a-a8db-38627fd0cbd1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TwistedPuncture", "[", "pars_List", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "phi", ",", " ", "rho2", ",", " ", "num", ",", " ", "beta", ",", " ", 
       "cross", ",", " ", "c", ",", " ", "q2", ",", " ", "rR", ",", " ", "tw",
        ",", " ", "scale", ",", " ", "numT", ",", " ", "rho2T", ",", " ", 
       "rhob2", ",", " ", "red", ",", " ", "F"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"phi", " ", "=", " ", 
       RowBox[{"\[CapitalPhi]sKerrEquatorial", " ", "/.", " ", "pars"}]}], 
      ";", "\n", "  ", 
      RowBox[{"rho2", " ", "=", " ", 
       RowBox[{"First", "@", 
        RowBox[{"Union", "@", 
         RowBox[{"Cases", "[", 
          RowBox[{"phi", ",", " ", 
           RowBox[{
            RowBox[{"Power", "[", 
             RowBox[{"b_", ",", " ", 
              RowBox[{
               RowBox[{"-", "7"}], "/", "2"}]}], "]"}], " ", ":>", " ", "b"}],
            ",", " ", "Infinity"}], "]"}]}]}]}], ";", "\n", "  ", 
      RowBox[{"num", " ", "=", " ", 
       RowBox[{"Expand", "[", 
        RowBox[{"Together", "[", 
         RowBox[{"phi", " ", 
          RowBox[{"rho2", "^", 
           RowBox[{"(", 
            RowBox[{"7", "/", "2"}], ")"}]}]}], "]"}], "]"}]}], ";", "\n", 
      "  ", 
      RowBox[{"beta", " ", "=", " ", 
       RowBox[{"Coefficient", "[", 
        RowBox[{"rho2", ",", " ", 
         RowBox[{"\[CapitalDelta]Q", "^", "2"}]}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"cross", " ", "=", " ", 
       RowBox[{"Coefficient", "[", 
        RowBox[{
         RowBox[{"Coefficient", "[", 
          RowBox[{"rho2", ",", " ", "\[CapitalDelta]r"}], "]"}], ",", " ", 
         "\[CapitalDelta]R"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"c", " ", "=", " ", 
       RowBox[{
        RowBox[{"-", "2"}], " ", 
        RowBox[{"cross", "/", "beta"}]}]}], ";", "\n", "  ", 
      RowBox[{"q2", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{"2", " ", 
              RowBox[{"\[CapitalDelta]Qb", "^", "2"}]}]}], ")"}], " ", 
           RowBox[{"Cos", "[", 
            RowBox[{"c", " ", "\[CapitalDelta]r"}], "]"}]}], " ", "+", " ", 
          RowBox[{"\[CapitalDelta]Rb", " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"c", " ", "\[CapitalDelta]r"}], "]"}]}]}], ")"}], "/", 
        "2"}]}], ";", "\n", "  ", 
      RowBox[{"rR", " ", "=", " ", 
       RowBox[{
        RowBox[{"\[CapitalDelta]Rb", " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"c", " ", "\[CapitalDelta]r"}], "]"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", 
           RowBox[{"2", " ", 
            RowBox[{"\[CapitalDelta]Qb", "^", "2"}]}]}], ")"}], " ", 
         RowBox[{"Sin", "[", 
          RowBox[{"c", " ", "\[CapitalDelta]r"}], "]"}]}]}]}], ";", "\n", 
      "  ", 
      RowBox[{
       RowBox[{"tw", "[", "x_", "]"}], " ", ":=", " ", 
       RowBox[{
        RowBox[{"x", " ", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[CapitalDelta]Q", "^", "n_"}], " ", ":>", " ", 
           RowBox[{"q2", "^", 
            RowBox[{"(", 
             RowBox[{"n", "/", "2"}], ")"}]}]}], "}"}]}], " ", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[CapitalDelta]Q", " ", "->", " ", 
           RowBox[{"Sqrt", "[", "q2", "]"}]}], ",", " ", 
          RowBox[{"\[CapitalDelta]R", " ", "->", " ", "rR"}]}], "}"}]}]}], 
      ";", "\n", "  ", 
      RowBox[{"scale", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[CapitalDelta]r", " ", "->", " ", 
          RowBox[{"\[Epsilon]", " ", "\[CapitalDelta]r"}]}], ",", " ", 
         RowBox[{"\[CapitalDelta]\[Theta]", " ", "->", " ", 
          RowBox[{"\[Epsilon]", " ", "\[CapitalDelta]\[Theta]"}]}], ",", " ", 
         
         RowBox[{"\[CapitalDelta]Qb", " ", "->", " ", 
          RowBox[{"\[Epsilon]", " ", "\[CapitalDelta]Qb"}]}], ",", " ", 
         RowBox[{"\[CapitalDelta]Rb", " ", "->", " ", 
          RowBox[{"\[Epsilon]", " ", "\[CapitalDelta]Rb"}]}]}], "}"}]}], ";", 
      "\n", "  ", 
      RowBox[{"numT", " ", "=", " ", 
       RowBox[{"Normal", "@", 
        RowBox[{"Series", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"tw", "[", "num", "]"}], " ", "/.", " ", "scale"}], ",", 
          " ", 
          RowBox[{"{", 
           RowBox[{"\[Epsilon]", ",", " ", "0", ",", " ", "9"}], "}"}]}], 
         "]"}]}]}], ";", "\n", "  ", 
      RowBox[{"rho2T", " ", "=", " ", 
       RowBox[{"Normal", "@", 
        RowBox[{"Series", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"tw", "[", "rho2", "]"}], " ", "/.", " ", "scale"}], ",", 
          " ", 
          RowBox[{"{", 
           RowBox[{"\[Epsilon]", ",", " ", "0", ",", " ", "9"}], "}"}]}], 
         "]"}]}]}], ";", "\n", "  ", 
      RowBox[{"rhob2", " ", "=", " ", 
       RowBox[{"Expand", "[", 
        RowBox[{"Coefficient", "[", 
         RowBox[{"rho2T", ",", " ", "\[Epsilon]", ",", " ", "2"}], "]"}], 
        "]"}]}], ";", "\n", "  ", 
      RowBox[{
       RowBox[{"red", "[", "x_", "]"}], " ", ":=", " ", 
       RowBox[{"Expand", "[", 
        RowBox[{
         RowBox[{"Expand", "[", "x", "]"}], " ", "/.", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"\[CapitalDelta]Rb", "^", "n_"}], " ", "/;", " ", 
           RowBox[{"n", " ", ">=", " ", "2"}]}], " ", ":>", " ", 
          RowBox[{
           RowBox[{"\[CapitalDelta]Rb", "^", 
            RowBox[{"Mod", "[", 
             RowBox[{"n", ",", " ", "2"}], "]"}]}], " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"4", " ", 
              RowBox[{"\[CapitalDelta]Qb", "^", "2"}], " ", 
              RowBox[{"(", 
               RowBox[{"1", " ", "-", " ", 
                RowBox[{
                 RowBox[{"\[Epsilon]", "^", "2"}], " ", 
                 RowBox[{"\[CapitalDelta]Qb", "^", "2"}]}]}], ")"}]}], ")"}], 
            "^", 
            RowBox[{"Quotient", "[", 
             RowBox[{"n", ",", " ", "2"}], "]"}]}]}]}]}], "]"}]}], ";", "\n", 
      "  ", 
      RowBox[{"F", " ", "=", " ", 
       RowBox[{"Normal", "@", 
        RowBox[{"Series", "[", 
         RowBox[{
          RowBox[{"red", "[", 
           RowBox[{"Normal", "@", 
            RowBox[{"Series", "[", 
             RowBox[{
              RowBox[{"numT", " ", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"rhob2", " ", 
                  RowBox[{
                   RowBox[{"\[Epsilon]", "^", "2"}], "/", "rho2T"}]}], ")"}], 
                "^", 
                RowBox[{"(", 
                 RowBox[{"7", "/", "2"}], ")"}]}]}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"\[Epsilon]", ",", " ", "0", ",", " ", "9"}], "}"}]}], 
             "]"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"\[Epsilon]", ",", " ", "0", ",", " ", "9"}], "}"}]}], 
         "]"}]}]}], ";", "\n", "  ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<c\>\"", " ", "->", " ", "c"}], ",", " ", 
        RowBox[{"\"\<alpha20\>\"", " ", "->", " ", 
         RowBox[{"Coefficient", "[", 
          RowBox[{"rhob2", ",", " ", 
           RowBox[{"\[CapitalDelta]r", "^", "2"}]}], "]"}]}], ",", " ", 
        RowBox[{"\"\<alpha02\>\"", " ", "->", " ", 
         RowBox[{"Coefficient", "[", 
          RowBox[{"rhob2", ",", " ", 
           RowBox[{"\[CapitalDelta]\[Theta]", "^", "2"}]}], "]"}]}], ",", " ", 
        RowBox[{"\"\<beta\>\"", " ", "->", " ", "beta"}], ",", "\n", "    ", 
        RowBox[{"\"\<A\>\"", " ", "->", " ", 
         RowBox[{"Expand", "[", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"Together", "[", 
             RowBox[{"Coefficient", "[", 
              RowBox[{"F", ",", " ", "\[Epsilon]", ",", " ", "k"}], "]"}], 
             "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"k", ",", " ", "6", ",", " ", "9"}], "}"}]}], "]"}], 
          "]"}]}]}], "|>"}]}]}], "]"}]}], ";"}]], "Input",ExpressionUUID->\
"6e6a6ab6-eac5-4adb-8d80-af49359b1031"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TwistedPhiS", "[", 
    RowBox[{
    "tw_Association", ",", " ", "dr_", ",", " ", "dth_", ",", " ", "dph_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", " ", "=", " ", 
       RowBox[{"dph", " ", "-", " ", 
        RowBox[{
         RowBox[{"tw", "[", "\"\<c\>\"", "]"}], " ", "dr"}]}]}], "}"}], ",", 
     "\n", "  ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"tw", "[", "\"\<A\>\"", "]"}], " ", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[CapitalDelta]r", " ", "->", " ", "dr"}], ",", " ", 
          RowBox[{"\[CapitalDelta]\[Theta]", " ", "->", " ", "dth"}], ",", 
          " ", 
          RowBox[{"\[CapitalDelta]Qb", " ", "->", " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"x", "/", "2"}], "]"}]}], ",", " ", 
          RowBox[{"\[CapitalDelta]Rb", " ", "->", " ", 
           RowBox[{"Sin", "[", "x", "]"}]}]}], "}"}]}], ")"}], "/", "\n", 
      "   ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"tw", "[", "\"\<alpha20\>\"", "]"}], " ", 
          RowBox[{"dr", "^", "2"}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"tw", "[", "\"\<alpha02\>\"", "]"}], " ", 
          RowBox[{"dth", "^", "2"}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"tw", "[", "\"\<beta\>\"", "]"}], " ", 
          RowBox[{
           RowBox[{"Sin", "[", 
            RowBox[{"x", "/", "2"}], "]"}], "^", "2"}]}]}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"7", "/", "2"}], ")"}]}]}]}], "]"}]}], ";"}]], "Input",Express\
ionUUID->"c62e14b6-d7bf-4d25-96d8-55489906f60f"]
}, Closed]],

Cell[CellGroupData[{

Cell["m-mode decomposition: elliptic-integral coefficients", "Section",ExpressionUUID->"5fd994a8-bfd8-4e37-8b3a-3dc55d30e359"],

Cell["\<\
With \[Rho]^2 = \[Alpha] + \[Beta] \[CapitalDelta]Q^2, \[Alpha] = \[Alpha]20 \
\[CapitalDelta]r^2 + \[Alpha]02 \[CapitalDelta]\[Theta]^2, C1 = \[Alpha]/\
\[Beta] and k^2 = 1/(1 + C1): the integral over \[CapitalDelta]\[Phi] in (0, \
2\[Pi]) of \[CapitalDelta]Q^(2j) Exp[-I m \[CapitalDelta]\[Phi]]/\[Rho]^7 \
equals 4 Sum[ReEI[m,i,j,k] {K, E}[[i]] C1^k]/(\[Beta] C1^3 (\[Alpha] + \
\[Beta])^(5/2)), and that of \[CapitalDelta]R \[CapitalDelta]Q^(2j) Exp[-I m \
\[CapitalDelta]\[Phi]]/\[Rho]^7 equals -32 I Sum[ImEI[m,i,j,k] {K, E}[[i]] \
C1^k]/(\[Beta]^2 C1^2 (\[Alpha] + \[Beta])^(3/2)), with K = K(k^2) and E = \
E(k^2). EllipticTableEntries[mmax] returns these coefficients exactly as \
{\"Re\" or \"Im\", m, i, j, k, value}, i = 0 for K and 1 for E. The integrals \
J_q = Integral[(1 - k^2 Sin[y]^2)^q, {y, 0, \[Pi]/2}] come from J_(1/2) = E, \
J_(-1/2) = K and 2(q+1) J_(q+1) = 2q(k^2-1) J_(q-1) - (k^2-2)(2q+1) J_q. \
Integrate is not used: for q >= -3/2 it returns transformed elliptic \
arguments, and the coefficient extraction would drop terms.\
\>", "Text",ExpressionUUID->"63ce9ac5-bedd-4c62-82aa-63bade14567f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"EllipticTableEntries", "[", "mmax_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"jt", " ", "=", " ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{
           RowBox[{"1", "/", "2"}], " ", "->", " ", "EE"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "1"}], "/", "2"}], " ", "->", " ", "KK"}]}], 
         "|>"}]}], ",", " ", "integ", ",", " ", "kecoeffs", ",", " ", "re", 
       ",", " ", "im", ",", " ", 
       RowBox[{"rows", " ", "=", " ", 
        RowBox[{"{", "}"}]}]}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"jt", "[", 
          RowBox[{"q", " ", "+", " ", "1"}], "]"}], " ", "=", " ", 
         RowBox[{"Together", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", "q", " ", 
              RowBox[{"(", 
               RowBox[{"mm", " ", "-", " ", "1"}], ")"}], " ", 
              RowBox[{"jt", "[", 
               RowBox[{"q", " ", "-", " ", "1"}], "]"}]}], " ", "-", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"mm", " ", "-", " ", "2"}], ")"}], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"2", " ", "q"}], " ", "+", " ", "1"}], ")"}], " ", 
              RowBox[{"jt", "[", "q", "]"}]}]}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", 
             RowBox[{"(", 
              RowBox[{"q", " ", "+", " ", "1"}], ")"}]}], ")"}]}], "]"}]}], 
        ",", " ", 
        RowBox[{"{", 
         RowBox[{"q", ",", " ", 
          RowBox[{"1", "/", "2"}], ",", " ", 
          RowBox[{"mmax", " ", "+", " ", 
           RowBox[{"5", "/", "2"}]}]}], "}"}]}], "]"}], ";", "\n", "  ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"jt", "[", 
          RowBox[{"q", " ", "-", " ", "1"}], "]"}], " ", "=", " ", 
         RowBox[{"Together", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", 
              RowBox[{"(", 
               RowBox[{"q", " ", "+", " ", "1"}], ")"}], " ", 
              RowBox[{"jt", "[", 
               RowBox[{"q", " ", "+", " ", "1"}], "]"}]}], " ", "+", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"mm", " ", "-", " ", "2"}], ")"}], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"2", " ", "q"}], " ", "+", " ", "1"}], ")"}], " ", 
              RowBox[{"jt", "[", "q", "]"}]}]}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", "q", " ", 
             RowBox[{"(", 
              RowBox[{"mm", " ", "-", " ", "1"}], ")"}]}], ")"}]}], "]"}]}], 
        ",", " ", 
        RowBox[{"{", 
         RowBox[{"q", ",", " ", 
          RowBox[{
           RowBox[{"-", "1"}], "/", "2"}], ",", " ", 
          RowBox[{
           RowBox[{"-", "5"}], "/", "2"}], ",", " ", 
          RowBox[{"-", "1"}]}], "}"}]}], "]"}], ";", "\n", "  ", 
      RowBox[{
       RowBox[{"integ", "[", "poly_", "]"}], " ", ":=", " ", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"cl", " ", "=", " ", 
           RowBox[{"CoefficientList", "[", 
            RowBox[{
             RowBox[{"Expand", "[", 
              RowBox[{"poly", " ", "/.", " ", 
               RowBox[{"u", " ", "->", " ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", " ", "-", " ", "w"}], ")"}], "/", "mm"}]}]}], 
              "]"}], ",", " ", "w"}], "]"}]}], "}"}], ",", " ", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"cl", "[", 
             RowBox[{"[", 
              RowBox[{"n", " ", "+", " ", "1"}], "]"}], "]"}], " ", 
            RowBox[{"jt", "[", 
             RowBox[{"n", " ", "-", " ", 
              RowBox[{"7", "/", "2"}]}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"n", ",", " ", "0", ",", " ", 
             RowBox[{
              RowBox[{"Length", "[", "cl", "]"}], " ", "-", " ", "1"}]}], 
            "}"}]}], "]"}]}], "]"}]}], ";", "\n", "  ", 
      RowBox[{
       RowBox[{"kecoeffs", "[", "x_", "]"}], " ", ":=", " ", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"e", " ", "=", " ", 
           RowBox[{"Together", "[", 
            RowBox[{"x", " ", "/.", " ", 
             RowBox[{"mm", " ", "->", " ", 
              RowBox[{"1", "/", 
               RowBox[{"(", 
                RowBox[{"1", " ", "+", " ", "c"}], ")"}]}]}]}], "]"}]}], 
          "}"}], ",", "\n", "    ", 
         RowBox[{
          RowBox[{
           RowBox[{"Factor", "[", 
            RowBox[{
             RowBox[{"Coefficient", "[", 
              RowBox[{
               RowBox[{"Numerator", "[", "e", "]"}], ",", " ", "#"}], "]"}], 
             "/", 
             RowBox[{"Denominator", "[", "e", "]"}]}], "]"}], " ", "&"}], " ",
           "/@", " ", 
          RowBox[{"{", 
           RowBox[{"KK", ",", " ", "EE"}], "}"}]}]}], "]"}]}], ";", "\n", 
      "  ", 
      RowBox[{"Do", "[", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"re", " ", "=", " ", 
          RowBox[{"kecoeffs", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"-", "1"}], ")"}], "^", "m"}], " ", 
            RowBox[{
             RowBox[{"c", "^", "3"}], "/", 
             RowBox[{"(", 
              RowBox[{"1", " ", "+", " ", "c"}], ")"}]}], " ", 
            RowBox[{"integ", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", " ", "-", " ", "u"}], ")"}], "^", "j"}], " ", 
              RowBox[{"ChebyshevT", "[", 
               RowBox[{"m", ",", " ", 
                RowBox[{"1", " ", "-", " ", 
                 RowBox[{"2", " ", "u"}]}]}], "]"}]}], "]"}]}], "]"}]}], ";", 
         "\n", "   ", 
         RowBox[{"im", " ", "=", " ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"m", " ", "==", " ", "0"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
            RowBox[{"kecoeffs", "[", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"-", "1"}], ")"}], "^", "m"}]}], " ", 
              RowBox[{
               RowBox[{"c", "^", "2"}], "/", 
               RowBox[{"(", 
                RowBox[{"8", " ", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"1", " ", "+", " ", "c"}], ")"}], "^", "2"}]}], 
                ")"}]}], " ", 
              RowBox[{"integ", "[", 
               RowBox[{"4", " ", "u", " ", 
                RowBox[{"(", 
                 RowBox[{"1", " ", "-", " ", "u"}], ")"}], " ", 
                RowBox[{"ChebyshevU", "[", 
                 RowBox[{
                  RowBox[{"m", " ", "-", " ", "1"}], ",", " ", 
                  RowBox[{"1", " ", "-", " ", 
                   RowBox[{"2", " ", "u"}]}]}], "]"}], " ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", " ", "-", " ", "u"}], ")"}], "^", "j"}]}], 
               "]"}]}], "]"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"!", 
               RowBox[{"PolynomialQ", "[", 
                RowBox[{
                 RowBox[{"tab", "[", 
                  RowBox[{"[", 
                   RowBox[{"2", ",", " ", "i"}], "]"}], "]"}], ",", " ", 
                 "c"}], "]"}]}], ",", " ", 
              RowBox[{"Return", "[", 
               RowBox[{"$Failed", ",", " ", "Module"}], "]"}]}], "]"}], ";", 
            "\n", "     ", 
            RowBox[{"rows", " ", "=", " ", 
             RowBox[{"Join", "[", 
              RowBox[{"rows", ",", " ", 
               RowBox[{"MapIndexed", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"tab", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", " ", "m", ",", " ", 
                    RowBox[{"i", " ", "-", " ", "1"}], ",", " ", "j", ",", 
                    " ", 
                    RowBox[{
                    RowBox[{"First", "[", "#2", "]"}], " ", "-", " ", "1"}], 
                    ",", " ", "#1"}], "}"}], " ", "&"}], ",", " ", 
                 RowBox[{"CoefficientList", "[", 
                  RowBox[{
                   RowBox[{"tab", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", " ", "i"}], "]"}], "]"}], ",", " ", 
                   "c"}], "]"}]}], "]"}]}], "]"}]}]}], ",", "\n", "    ", 
           RowBox[{"{", 
            RowBox[{"tab", ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\"\<Re\>\"", ",", " ", "re"}], "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"\"\<Im\>\"", ",", " ", "im"}], "}"}]}], "}"}]}], 
            "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "2"}], "}"}]}], "]"}]}], ",", "\n", "   ", 
        
        RowBox[{"{", 
         RowBox[{"m", ",", " ", "0", ",", " ", "mmax"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}], ";", 
      "\n", "  ", "rows"}]}], "]"}]}], ";"}]], "Input",ExpressionUUID->\
"d933619d-b2b3-40b1-90c5-111cfee9f6e0"]
}, Closed]],

Cell[CellGroupData[{

Cell["(m,n)-mode decomposition: numerical projection", "Section",ExpressionUUID->"15d10ed4-a51d-447e-a388-050726d9c29a"],

Cell["\<\
A_mn(r, \[Theta]) = (1/T_r) \[Integral] dt Exp[I (m \[CapitalOmega]_\[Phi] + \
n \[CapitalOmega]_r) t] C_m(t) over one radial period, with C_m(t) = \
\[Integral] d\[Phi] Exp[-I m \[Phi]] \[CapitalPhi](t; r, \[Theta], \[Phi]) \
and \[CapitalPhi] the twisted puncture (TwistedPhiS) of the particle at its \
geodesic position at time t; t = \[Phi]_p = 0 at periapsis. The orbit comes \
from KerrGeoOrbit and KerrGeoFrequencies of the KerrGeodesics paclet in Mino \
time \[Lambda]. A_mn is real, and A_mn = (2/T_r) Re \[Integral] d\[Lambda] \
t'(\[Lambda]) Exp[I \[Omega]_mn t(\[Lambda])] C_m(\[Lambda]) over half a \
radial period. The time integral is a composite Gauss-Legendre rule graded at \
the crossing time \[Lambda]_c, where r_p(\[Lambda]_c) = r, or a tanh-sinh \
rule mirrored about \[Lambda]_c on the equatorial plane; the \[Phi] integral \
is a Gauss-Legendre rule after the substitution \[CapitalDelta]\[Phi] = c \
\[CapitalDelta]r + s Sinh[u]. EffectiveSource4D is the pointwise \
Boyer-Lindquist d'Alembertian of the puncture, with time derivatives from \
fourth-order differences in \[Lambda] at a fixed field point. MNModes returns \
the projections of the puncture, its r and \[Theta] derivatives and the \
source from two rules of different order, and the number of agreeing digits.\
\>", "Text",ExpressionUUID->"44f3214d-661b-4c10-8682-bdd728d7d7bb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Needs", "[", "\"\<KerrGeodesics`\>\"", "]"}], ";", " ", 
  RowBox[{
  "Needs", "[", "\"\<NumericalDifferentialEquationAnalysis`\>\"", "]"}], 
  ";"}]], "Input",ExpressionUUID->"2d6e9bf0-0b58-43b8-8d47-032b8f44e5c2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"KerrEquatorialOrbit", "[", 
    RowBox[{"a0_", ",", " ", "p0_", ",", " ", "e0_", ",", " ", "prec_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"aN", " ", "=", " ", 
        RowBox[{"N", "[", 
         RowBox[{"a0", ",", " ", "prec"}], "]"}]}], ",", " ", "orb", ",", " ",
        "ups", ",", " ", "tf", ",", " ", "rf", ",", " ", "thf", ",", " ", 
       "phf", ",", " ", "en", ",", " ", "el", ",", " ", "lr", ",", " ", "tr", 
       ",", " ", "vt", ",", " ", "dvt", ",", " ", "drf"}], "}"}], ",", "\n", 
     "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"orb", ",", " ", "ups"}], "}"}], " ", "=", " ", 
       RowBox[{"Quiet", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"KerrGeoOrbit", "[", 
           RowBox[{"aN", ",", " ", 
            RowBox[{"N", "[", 
             RowBox[{"p0", ",", " ", "prec"}], "]"}], ",", " ", 
            RowBox[{"N", "[", 
             RowBox[{"e0", ",", " ", "prec"}], "]"}], ",", " ", 
            RowBox[{"N", "[", 
             RowBox[{"1", ",", " ", "prec"}], "]"}], ",", " ", 
            RowBox[{"Method", " ", "->", " ", "\"\<Analytic\>\""}]}], "]"}], 
          ",", " ", 
          RowBox[{"KerrGeoFrequencies", "[", 
           RowBox[{"aN", ",", " ", 
            RowBox[{"N", "[", 
             RowBox[{"p0", ",", " ", "prec"}], "]"}], ",", " ", 
            RowBox[{"N", "[", 
             RowBox[{"e0", ",", " ", "prec"}], "]"}], ",", " ", 
            RowBox[{"N", "[", 
             RowBox[{"1", ",", " ", "prec"}], "]"}], ",", " ", 
            RowBox[{"Time", " ", "->", " ", "\"\<Mino\>\""}]}], "]"}]}], 
         "}"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"tf", ",", " ", "rf", ",", " ", "thf", ",", " ", "phf"}], 
        "}"}], " ", "=", " ", 
       RowBox[{"Quiet", "[", 
        RowBox[{"orb", "[", "\"\<Trajectory\>\"", "]"}], "]"}]}], ";", "\n", 
      "  ", 
      RowBox[{"en", " ", "=", " ", 
       RowBox[{"orb", "[", "\"\<Energy\>\"", "]"}]}], ";", " ", 
      RowBox[{"el", " ", "=", " ", 
       RowBox[{"orb", "[", "\"\<AngularMomentum\>\"", "]"}]}], ";", "\n", 
      "  ", 
      RowBox[{"lr", " ", "=", " ", 
       RowBox[{"2", " ", 
        RowBox[{"Pi", "/", 
         RowBox[{"First", "[", 
          RowBox[{"Values", "[", "ups", "]"}], "]"}]}]}]}], ";", "\n", "  ", 
      RowBox[{"tr", " ", "=", " ", 
       RowBox[{"tf", "[", "lr", "]"}]}], ";", "\n", "  ", 
      RowBox[{"drf", " ", "=", " ", 
       RowBox[{
        RowBox[{"Derivative", "[", "1", "]"}], "[", "rf", "]"}]}], ";", "\n", 
      "  ", 
