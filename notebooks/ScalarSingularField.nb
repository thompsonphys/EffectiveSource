     RowBox[{
      RowBox[{
       SubsuperscriptBox[
        OverscriptBox["r", "~"], "0", "4"], " ", 
       SubscriptBox[
        OverscriptBox["\[CapitalDelta]", "~"], "0"], " ", 
       SuperscriptBox["\[Delta]r", "2"]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          OverscriptBox["a", "~"], "2"], "-", 
         SubscriptBox[
          OverscriptBox["r", "~"], "0"]}], ")"}], " ", 
       SubsuperscriptBox[
        OverscriptBox["r", "~"], "0", "3"], " ", 
       SuperscriptBox["\[Delta]r", "3"]}], "+", 
      RowBox[{
       SubsuperscriptBox[
        OverscriptBox["r", "~"], "0", "4"], " ", 
       SubsuperscriptBox[
        OverscriptBox["\[CapitalDelta]", "~"], "0", "2"], " ", 
       SuperscriptBox["\[Delta]\[Theta]", "2"]}], "+", 
      RowBox[{
       SubscriptBox[
        OverscriptBox["r", "~"], "0"], " ", 
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox[
          OverscriptBox["r", "~"], "0", "3"], "+", 
         RowBox[{
          SuperscriptBox[
           OverscriptBox["a", "~"], "2"], " ", 
          RowBox[{"(", 
           RowBox[{"2", "+", 
            SubscriptBox[
             OverscriptBox["r", "~"], "0"]}], ")"}]}]}], ")"}], " ", 
       SubsuperscriptBox[
        OverscriptBox["\[CapitalDelta]", "~"], "0", "2"], " ", 
       SuperscriptBox["\[Delta]\[Phi]", "2"]}], "+", 
      RowBox[{"\[Delta]r", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubsuperscriptBox[
           OverscriptBox["r", "~"], "0", "3"], " ", 
          SubsuperscriptBox[
           OverscriptBox["\[CapitalDelta]", "~"], "0", "2"], " ", 
          SuperscriptBox["\[Delta]\[Theta]", "2"]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             SuperscriptBox[
              OverscriptBox["a", "~"], "2"]}], "+", 
            SubsuperscriptBox[
             OverscriptBox["r", "~"], "0", "3"]}], ")"}], " ", 
          SubsuperscriptBox[
           OverscriptBox["\[CapitalDelta]", "~"], "0", "2"], " ", 
          SuperscriptBox["\[Delta]\[Phi]", "2"]}]}], ")"}]}]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubsuperscriptBox[
        OverscriptBox["r", "~"], "0", "4"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "3"}], " ", 
          SuperscriptBox[
           OverscriptBox["a", "~"], "2"], " ", 
          SqrtBox["M"]}], "+", 
         RowBox[{
          SqrtBox["M"], " ", 
          RowBox[{"(", 
           RowBox[{"3", "-", 
            RowBox[{"2", " ", 
             SubscriptBox[
              OverscriptBox["r", "~"], "0"]}]}], ")"}], " ", 
          SubscriptBox[
           OverscriptBox["r", "~"], "0"]}], "+", 
         RowBox[{"2", " ", 
          OverscriptBox["a", "~"], " ", 
          SqrtBox[
           RowBox[{"M", " ", 
            SubscriptBox[
             OverscriptBox["r", "~"], "0"]}]]}]}], ")"}], " ", 
       SubscriptBox[
        OverscriptBox["\[CapitalDelta]", "~"], "0"], " ", 
       SuperscriptBox["\[Delta]r", "2"]}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          OverscriptBox["a", "~"], "2"], "-", 
         SubscriptBox[
          OverscriptBox["r", "~"], "0"]}], ")"}], " ", 
       SubsuperscriptBox[
        OverscriptBox["r", "~"], "0", "3"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"3", " ", 
          SuperscriptBox[
           OverscriptBox["a", "~"], "2"], " ", 
          SqrtBox["M"]}], "-", 
         RowBox[{"2", " ", 
          OverscriptBox["a", "~"], " ", 
          SqrtBox[
           RowBox[{"M", " ", 
            SubscriptBox[
             OverscriptBox["r", "~"], "0"]}]]}], "+", 
         RowBox[{
          SqrtBox["M"], " ", 
          SubscriptBox[
           OverscriptBox["r", "~"], "0"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "3"}], "+", 
            RowBox[{"2", " ", 
             SubscriptBox[
              OverscriptBox["r", "~"], "0"]}]}], ")"}]}]}], ")"}], " ", 
       SuperscriptBox["\[Delta]r", "3"]}], "+", 
      RowBox[{
       SubsuperscriptBox[
        OverscriptBox["r", "~"], "0", "4"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"3", " ", 
          SuperscriptBox[
           OverscriptBox["a", "~"], "2"], " ", 
          SqrtBox["M"]}], "+", 
         RowBox[{
          SqrtBox["M"], " ", 
          SubsuperscriptBox[
           OverscriptBox["r", "~"], "0", "2"]}], "-", 
         RowBox[{"4", " ", 
          OverscriptBox["a", "~"], " ", 
          SqrtBox[
           RowBox[{"M", " ", 
            SubscriptBox[
             OverscriptBox["r", "~"], "0"]}]]}]}], ")"}], " ", 
       SubsuperscriptBox[
        OverscriptBox["\[CapitalDelta]", "~"], "0", "2"], " ", 
       SuperscriptBox["\[Delta]\[Theta]", "2"]}], "+", 
      RowBox[{
       SubscriptBox[
        OverscriptBox["r", "~"], "0"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SuperscriptBox[
           OverscriptBox["a", "~"], "2"], " ", 
          SqrtBox["M"]}], "+", 
         RowBox[{
          SqrtBox["M"], " ", 
          SubsuperscriptBox[
           OverscriptBox["r", "~"], "0", "3"]}], "+", 
         RowBox[{"2", " ", 
          OverscriptBox["a", "~"], " ", 
          SubscriptBox[
           OverscriptBox["r", "~"], "0"], " ", 
          SqrtBox[
           RowBox[{"M", " ", 
            SubscriptBox[
             OverscriptBox["r", "~"], "0"]}]]}]}], ")"}], " ", 
       SubsuperscriptBox[
        OverscriptBox["\[CapitalDelta]", "~"], "0", "3"], " ", 
       SuperscriptBox["\[Delta]\[Phi]", "2"]}], "+", 
      RowBox[{"\[Delta]r", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubsuperscriptBox[
           OverscriptBox["r", "~"], "0", "3"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"9", " ", 
             SuperscriptBox[
              OverscriptBox["a", "~"], "2"], " ", 
             SqrtBox["M"]}], "-", 
            RowBox[{"10", " ", 
             OverscriptBox["a", "~"], " ", 
             SqrtBox[
              RowBox[{"M", " ", 
               SubscriptBox[
                OverscriptBox["r", "~"], "0"]}]]}], "+", 
            RowBox[{
             SqrtBox["M"], " ", 
             SubscriptBox[
              OverscriptBox["r", "~"], "0"], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "3"}], "+", 
               RowBox[{"4", " ", 
                SubscriptBox[
                 OverscriptBox["r", "~"], "0"]}]}], ")"}]}]}], ")"}], " ", 
          SubsuperscriptBox[
           OverscriptBox["\[CapitalDelta]", "~"], "0", "2"], " ", 
          SuperscriptBox["\[Delta]\[Theta]", "2"]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "3"}], " ", 
             SuperscriptBox[
              OverscriptBox["a", "~"], "4"], " ", 
             SqrtBox["M"]}], "+", 
            RowBox[{"2", " ", 
             OverscriptBox["a", "~"], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "1"}], "+", 
               SubscriptBox[
                OverscriptBox["r", "~"], "0"]}], ")"}], " ", 
             SubsuperscriptBox[
              OverscriptBox["r", "~"], "0", "2"], " ", 
             SqrtBox[
              RowBox[{"M", " ", 
               SubscriptBox[
                OverscriptBox["r", "~"], "0"]}]]}], "+", 
            RowBox[{
             SqrtBox["M"], " ", 
             SubsuperscriptBox[
              OverscriptBox["r", "~"], "0", "4"], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "7"}], "+", 
               RowBox[{"4", " ", 
                SubscriptBox[
                 OverscriptBox["r", "~"], "0"]}]}], ")"}]}], "+", 
            RowBox[{
             SuperscriptBox[
              OverscriptBox["a", "~"], "2"], " ", 
             SqrtBox["M"], " ", 
             SubscriptBox[
              OverscriptBox["r", "~"], "0"], " ", 
             RowBox[{"(", 
              RowBox[{"5", "-", 
               RowBox[{"2", " ", 
                SubscriptBox[
                 OverscriptBox["r", "~"], "0"]}], "+", 
               RowBox[{"3", " ", 
                SubsuperscriptBox[
                 OverscriptBox["r", "~"], "0", "2"]}]}], ")"}]}]}], ")"}], 
          " ", 
          SubsuperscriptBox[
           OverscriptBox["\[CapitalDelta]", "~"], "0", "2"], " ", 
          SuperscriptBox["\[Delta]\[Phi]", "2"]}]}], ")"}]}]}], ")"}]}]}], 
