               RowBox[{"r1", "^", "2"}], "+", 
               RowBox[{"2", "*", "a", "*", 
                RowBox[{"Sqrt", "[", 
                 RowBox[{"M", "*", "r1"}], "]"}]}]}], ")"}], "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"a", "^", "2"}], "+", 
               RowBox[{"r1", "*", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"-", "2"}], "*", "M"}], "+", "r1"}], ")"}]}]}], 
              ")"}]}], ")"}]}]}], ")"}]}]}], ")"}], "/", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"4", "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"r1", "^", "2"}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"a", "^", "2"}], "*", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"2", "*", "M"}], "+", "r1"}], ")"}]}], ")"}], "/", 
            "r1"}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"M", "*", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"a", "^", "2"}], "*", "r1"}], "+", 
                 RowBox[{"r1", "^", "3"}], "-", 
                 RowBox[{"2", "*", "a", "*", 
                  RowBox[{"Sqrt", "[", 
                   RowBox[{"M", "*", 
                    RowBox[{"r1", "^", "3"}]}], "]"}]}]}], ")"}], "^", 
               "2"}]}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"r1", "^", "3"}], "*", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"-", "3"}], "*", "M", "*", "r1"}], "+", 
                RowBox[{"r1", "^", "2"}], "+", 
                RowBox[{"2", "*", "a", "*", 
                 RowBox[{"Sqrt", "[", 
                  RowBox[{"M", "*", "r1"}], "]"}]}]}], ")"}]}], ")"}]}]}], 
          ")"}], "*", 
         RowBox[{"\[CapitalDelta]Q", "^", "2"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"r1", "^", "2"}], "*", 
           RowBox[{"\[CapitalDelta]r", "^", "2"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{
