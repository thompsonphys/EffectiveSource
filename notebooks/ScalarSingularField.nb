            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "2"}], "*", "M"}], "+", "r1"}], ")"}]}]}], 
          ")"}]}], "+", 
        RowBox[{
         RowBox[{"r1", "^", "2"}], "*", 
         RowBox[{"\[CapitalDelta]\[Theta]", "^", "2"}]}]}], ")"}], "^", 
