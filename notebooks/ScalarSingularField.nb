               RowBox[{"2", "+", 
                SubscriptBox[
                 OverscriptBox["r", "~"], "0"]}], ")"}]}]}], ")"}], " ", "ut",
            " ", "u\[Phi]"}], "+", 
          RowBox[{"2", " ", 
           SuperscriptBox["M", "2"], " ", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              SubsuperscriptBox[
               OverscriptBox["r", "~"], "0", "3"], "+", 
              RowBox[{
               SuperscriptBox[
                OverscriptBox["a", "~"], "2"], " ", 
               RowBox[{"(", 
                RowBox[{"2", "+", 
                 SubscriptBox[
                  OverscriptBox["r", "~"], "0"]}], ")"}]}]}], ")"}], "2"], 
           " ", 
           SuperscriptBox["u\[Phi]", "2"]}]}], ")"}], " ", 
        SubscriptBox[
         OverscriptBox["\[CapitalDelta]", "~"], "0"], " ", 
        SuperscriptBox["\[Delta]\[Phi]", "2"]}]}], ")"}]}], "-", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"8", " ", 
       SubsuperscriptBox[
        OverscriptBox["r", "~"], "0", "5"], " ", 
       SubsuperscriptBox[
        OverscriptBox["\[CapitalDelta]", "~"], "0", "2"]}]], 
