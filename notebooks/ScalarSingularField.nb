Cell[CellGroupData[{

Cell["Circular geodesic (alternate form)", "Subsection",
 CellChangeTimes->{{3.537004684219205*^9, 
  3.537004697301899*^9}},ExpressionUUID->"7763519a-e596-426e-8ce7-\
71f443d39d3a"],

Cell[TextData[{
 "This alternate form was used in: ",
 ButtonBox["\[OpenCurlyDoubleQuote]Self force via m-mode regularization and \
2+1D evolution: II. Scalar-field implementation on Kerr spacetime\
\[CloseCurlyDoubleQuote], Dolan, Barack and Wardell (2011)",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://prd.aps.org/abstract/PRD/v84/i8/e084001"], None},
  ButtonNote->"http://prd.aps.org/abstract/PRD/v84/i8/e084001"],
 ". These expressions were given in the appendix there; we given them here \
for convenience."
}], "Text",
 CellChangeTimes->{{3.537004699744203*^9, 3.537004771134324*^9}, {
  3.537004822650729*^9, 3.5370048226516323`*^9}, {3.537005110014373*^9, 
  3.537005117288527*^9}, {3.537005472498563*^9, 
  3.5370055156498327`*^9}},ExpressionUUID->"9d2a8081-3250-4691-b7a8-\
9f804637e2f8"],

Cell[TextData[{
 "Note that the following expressions use the a-dimensionalized variables:\n\
",
 Cell[BoxData[
  FormBox[
   RowBox[{"\n", 
    RowBox[{
     RowBox[{
      OverscriptBox["a", "~"], "=", 
      RowBox[{"a", "/", "M"}]}], "\[IndentingNewLine]", 
     RowBox[{
      SubscriptBox[
       OverscriptBox["r", "~"], "0"], "=", 
      RowBox[{"r1", "/", "M"}]}], "\[IndentingNewLine]", 
     RowBox[{
      SubscriptBox[
       OverscriptBox["\[CapitalDelta]", "~"], "0"], "=", 
      RowBox[{
       RowBox[{"\[CapitalDelta]", "/", 
        SuperscriptBox["M", "2"]}], "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["a", "2"], "+", 
          RowBox[{"r1", "(", 
           RowBox[{"r1", "-", 
            RowBox[{"2", "M"}]}], ")"}]}], ")"}], "/", 
        SuperscriptBox["M", "2"]}]}]}], "\[IndentingNewLine]", 
     RowBox[{
      SuperscriptBox[
       OverscriptBox["u", "~"], "\[Phi]"], "=", 
      RowBox[{"u\[Phi]1", "/", "M"}]}]}]}], TraditionalForm]],ExpressionUUID->
  "1c0ad564-0830-4811-8bdd-02cad98ff810"]
}], "Text",
 CellChangeTimes->{{3.537005121267851*^9, 3.5370051645133753`*^9}, {
   3.537005203924657*^9, 3.5370052774495564`*^9}, {3.5370053202980537`*^9, 
   3.537005333947847*^9}, 
   3.5370054538112164`*^9},ExpressionUUID->"50ae8ad7-cbfc-4662-9c9c-\
5d6e875b77a2"],

