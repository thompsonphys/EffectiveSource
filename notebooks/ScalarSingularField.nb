Cell[TextData[{
 "Note that the four-velocity of a general equatorial geodesic in Kerr may be \
given in terms of the constants of motion:\n\n",
 Cell[BoxData[{
  RowBox[{
   SuperscriptBox["ur1", "2"], "=", 
   RowBox[{
    SuperscriptBox["e1", "2"], "-", "1", "-", 
    RowBox[{"2", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["M", "r1"]}], "+", 
       FractionBox[
        RowBox[{
         SuperscriptBox["l1", "2"], "-", 
         RowBox[{
          SuperscriptBox["a", "2"], 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["e1", "2"], "-", "1"}], ")"}]}]}], 
        RowBox[{"2", 
         SuperscriptBox["r1", "2"]}]], "-", 
       FractionBox[
        RowBox[{"M", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"l1", "-", 
            RowBox[{"a", " ", "e1"}]}], ")"}], "2"]}], 
        SuperscriptBox["r1", "3"]]}], ")"}]}]}]}], "\[IndentingNewLine]", 
  RowBox[{"ut1", "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{
      SuperscriptBox["r1", "2"], "-", 
      RowBox[{"2", "M", " ", "r1"}], "+", 
      SuperscriptBox["a", "2"]}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["r1", "2"], "+", 
         SuperscriptBox["a", "2"], "+", 
         FractionBox[
          RowBox[{"2", "M", " ", 
           SuperscriptBox["a", "2"]}], "r1"]}], ")"}], "e1"}], "-", 
      RowBox[{
       FractionBox[
        RowBox[{"2", "M", " ", "a"}], "r1"], "l1"}]}], 
     ")"}]}]}], "\[IndentingNewLine]", 
  RowBox[{"u\[Phi]1", "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{
      SuperscriptBox["r1", "2"], "-", 
      RowBox[{"2", "M", " ", "r1"}], "+", 
      SuperscriptBox["a", "2"]}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         FractionBox[
          RowBox[{"2", "M"}], "r1"]}], ")"}], "l1"}], "+", 
      RowBox[{
       FractionBox[
        RowBox[{"2", "M", " ", "a"}], "r1"], "e1"}]}], ")"}]}]}]}],
  CellChangeTimes->{{3.529244673438335*^9, 3.529244675026743*^9}, {
    3.530978977838888*^9, 3.5309789912369843`*^9}, {3.5353784360986023`*^9, 
    3.535378444291664*^9}, {3.5365620994214287`*^9, 3.536562102604096*^9}, {
    3.536562218022279*^9, 3.536562270608309*^9}, 3.5365626288543587`*^9, {
    3.536563835984952*^9, 3.536563864808775*^9}, {3.537003290438818*^9, 
    3.5370033112154408`*^9}}],
 "\n\nWe have used this fact to simplify the following expression for the \
singular field"
}], "Text",
