                RowBox[{"a", "^", "2"}], "*", 
                RowBox[{"r1", "^", "4"}], "*", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"3", "*", 
                   RowBox[{"M", "^", "2"}]}], "+", 
                  RowBox[{"9", "*", "M", "*", "r1"}], "-", 
                  RowBox[{"4", "*", 
                   RowBox[{"r1", "^", "2"}]}]}], ")"}]}], "+", 
               RowBox[{
                RowBox[{"r1", "^", "6"}], "*", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"-", "6"}], "*", 
                   RowBox[{"M", "^", "2"}]}], "+", 
                  RowBox[{"M", "*", "r1"}], "+", 
                  RowBox[{"r1", "^", "2"}]}], ")"}]}], "+", 
               RowBox[{
                RowBox[{"a", "^", "3"}], "*", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"60", "*", 
                   RowBox[{"M", "^", 
                    RowBox[{"(", 
                    RowBox[{"3", "/", "2"}], ")"}]}], "*", 
                   RowBox[{"r1", "^", 
                    RowBox[{"(", 
                    RowBox[{"7", "/", "2"}], ")"}]}]}], "-", 
                  RowBox[{"16", "*", 
                   RowBox[{"Sqrt", "[", 
                    RowBox[{"M", "*", 
                    RowBox[{"r1", "^", "9"}]}], "]"}]}]}], ")"}]}], "+", 
               RowBox[{"2", "*", "a", "*", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"-", "24"}], "*", 
                   RowBox[{"M", "^", 
                    RowBox[{"(", 
                    RowBox[{"5", "/", "2"}], ")"}]}], "*", 
                   RowBox[{"r1", "^", 
                    RowBox[{"(", 
                    RowBox[{"9", "/", "2"}], ")"}]}]}], "+", 
                  RowBox[{"10", "*", 
                   RowBox[{"M", "^", 
                    RowBox[{"(", 
                    RowBox[{"3", "/", "2"}], ")"}]}], "*", 
                   RowBox[{"r1", "^", 
                    RowBox[{"(", 
                    RowBox[{"11", "/", "2"}], ")"}]}]}], "+", 
                  RowBox[{"Sqrt", "[", 
                   RowBox[{"M", "*", 
                    RowBox[{"r1", "^", "13"}]}], "]"}]}], ")"}]}]}], ")"}], 
             "*", 
             RowBox[{"\[CapitalDelta]\[Theta]", "^", "8"}]}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"48", "*", 
             RowBox[{"(", 
              RowBox[{
