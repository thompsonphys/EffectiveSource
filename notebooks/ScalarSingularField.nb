        SubscriptBox[
         OverscriptBox["r", "~"], "0"]}]], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", 
          SuperscriptBox[
           OverscriptBox["a", "~"], "3"], " ", 
          SqrtBox[
           SubscriptBox[
            OverscriptBox["r", "~"], "0"]], " ", 
          RowBox[{"(", 
