      RowBox[{
       RowBox[{
        SubsuperscriptBox[
         OverscriptBox["r", "~"], "0", "3"], " ", 
        SuperscriptBox["\[Delta]r", "2"]}], "+", 
       RowBox[{
        SubsuperscriptBox[
         OverscriptBox["r", "~"], "0", "3"], " ", 
        SubscriptBox[
         OverscriptBox["\[CapitalDelta]", "~"], "0"], " ", 
        SuperscriptBox["\[Delta]\[Theta]", "2"]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SubsuperscriptBox[
           OverscriptBox["r", "~"], "0", "3"], "+", 
          RowBox[{
           SuperscriptBox[
            OverscriptBox["a", "~"], "2"], " ", 
           RowBox[{"(", 
