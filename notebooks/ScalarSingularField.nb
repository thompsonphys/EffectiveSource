  3.5370054289061327`*^9}},ExpressionUUID->"b2c6dcc8-f266-4a22-93cd-\
fc9446f3d14c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Beta]5", "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", 
      RowBox[{"4", " ", 
       SubsuperscriptBox[
        OverscriptBox["r", "~"], "0", "7"]}]], 
     SuperscriptBox["M", "3"], " ", "ut", " ", "u\[Phi]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "ut"}], "+", 
       RowBox[{
        OverscriptBox["a", "~"], " ", "M", " ", "u\[Phi]"}]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], " ", 
        OverscriptBox["a", "~"], " ", "ut"}], "+", 
       RowBox[{"M", " ", 
        SubsuperscriptBox[
         OverscriptBox["r", "~"], "0", "3"], " ", "u\[Phi]"}], "+", 
       RowBox[{
        SuperscriptBox[
         OverscriptBox["a", "~"], "2"], " ", "M", " ", 
        RowBox[{"(", 
         RowBox[{"2", "+", 
          SubscriptBox[
           OverscriptBox["r", "~"], "0"]}], ")"}], " ", "u\[Phi]"}]}], ")"}], 
     " ", "\[Delta]r", " ", 
     SuperscriptBox["\[Delta]\[Phi]", "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"3", " ", 
        SubsuperscriptBox[
         OverscriptBox["r", "~"], "0", "4"], " ", 
        SuperscriptBox["\[Delta]r", "2"]}], "+", 
       RowBox[{"3", " ", 
        SubsuperscriptBox[
         OverscriptBox["r", "~"], "0", "4"], " ", 
        SubscriptBox[
         OverscriptBox["\[CapitalDelta]", "~"], "0"], " ", 
        SuperscriptBox["\[Delta]\[Theta]", "2"]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"6", " ", 
           SuperscriptBox[
            OverscriptBox["a", "~"], "2"], " ", 
           SubscriptBox[
            OverscriptBox["r", "~"], "0"]}], "+", 
          RowBox[{"3", " ", 
           SuperscriptBox[
            OverscriptBox["a", "~"], "2"], " ", 
           SubsuperscriptBox[
            OverscriptBox["r", "~"], "0", "2"]}], "+", 
          RowBox[{"3", " ", 
           SubsuperscriptBox[
            OverscriptBox["r", "~"], "0", "4"]}], "+", 
          RowBox[{"8", " ", 
           SuperscriptBox[
            OverscriptBox["a", "~"], "2"], " ", 
           SuperscriptBox["ut", "2"]}], "-", 
          RowBox[{"8", " ", 
           OverscriptBox["a", "~"], " ", "M", " ", 
           RowBox[{"(", 
            RowBox[{
             SubsuperscriptBox[
              OverscriptBox["r", "~"], "0", "3"], "+", 
             RowBox[{
              SuperscriptBox[
               OverscriptBox["a", "~"], "2"], " ", 
